{
  "name": "AT21CS01_AT21CS11",
  "version": "2.0.0",
  "description": "Arduino/PlatformIO driver for Microchip AT21CS01 and AT21CS11 single-wire EEPROMs on ESP32-S2/S3.",
  "keywords": [
    "microchip",
    "at21cs01",
    "at21cs11",
    "single-wire",
    "eeprom",
    "esp32",
    "arduino",
    "platformio"
  ],
  "authors": [
    {
      "name": "Jan Havelka",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/AT21CS11.git"
  },
  "license": "MIT",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "AT21CS/AT21CS.h"
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src"
  },
  "export": {
    "include": [
      "include/AT21CS/**",
      "src/**",
      "library.json",
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "docs/MIGRATION.md",
      "docs/IRREVERSIBLE_OPERATIONS.md",
      "docs/HARDWARE_VALIDATION.md",
      "examples/01_basic_bringup_cli/**",
      "examples/02_multi_device_cli/**",
      "examples/common/**"
    ]
  }
}
