{
  "name": "AT21CS01_AT21CS11",
  "version": "2.0.0",
  "description": "Microchip AT21CS01 and AT21CS11 single-wire EEPROM driver for Arduino-ESP32 and native ESP-IDF on ESP32-S2/S3.",
  "keywords": [
    "microchip",
    "at21cs01",
    "at21cs11",
    "single-wire",
    "eeprom",
    "esp32",
    "arduino",
    "platformio",
    "esp-idf"
  ],
  "authors": [
    {
      "name": "THYMOS Solution s.r.o.",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz"
    },
    {
      "name": "Jan Havelka",
      "email": "info@thymos.cz",
      "url": "https://www.thymos.cz",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/AT21CS11.git"
  },
  "homepage": "https://github.com/janhavelka/AT21CS11",
  "license": "MIT",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "AT21CS/AT21CS.h"
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src"
  },
  "export": {
    "include": [
      "include/AT21CS/**",
      "src/**",
      "library.json",
      "CMakeLists.txt",
      "idf_component.yml",
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "docs/ESP_IDF.md",
      "docs/MIGRATION.md",
      "docs/IRREVERSIBLE_OPERATIONS.md",
      "docs/HARDWARE_VALIDATION.md",
      "examples/01_basic_bringup_cli/**",
      "examples/02_multi_device_cli/**",
      "examples/common/**",
      "examples/esp_idf/basic/CMakeLists.txt",
      "examples/esp_idf/basic/README.md",
      "examples/esp_idf/basic/sdkconfig.defaults",
      "examples/esp_idf/basic/sdkconfig.defaults.esp32s2",
      "examples/esp_idf/basic/sdkconfig.defaults.esp32s3",
      "examples/esp_idf/basic/components/AT21CS01_AT21CS11/CMakeLists.txt",
      "examples/esp_idf/basic/main/CMakeLists.txt",
      "examples/esp_idf/basic/main/GenerateBuildIdentity.cmake",
      "examples/esp_idf/basic/main/main.cpp"
    ]
  }
}
